Funcion leerNumeros(numeros)
    Definir i Como Entero;
    Para i <- 1 Hasta 5 Con Paso 1 Hacer
        Escribir "Ingresa el número ", i, ": "
        Leer numeros[i]
    FinPara
FinFuncion

Funcion total <- sumarNumeros(numeros)
    Definir total, i Como Real;
    total <- 0
    Para i <- 1 Hasta 5 Con Paso 1 Hacer
        total <- total + numeros[i]
    FinPara
FinFuncion
Funcion mostrarResultado(total)
    Escribir "La suma total es: ", + total
FinFuncion

Algoritmo Principal
    Definir numeros, resultado Como Real;
    Dimension numeros[5]
    
    leerNumeros(numeros);
    resultado <- sumarNumeros(numeros);
    mostrarResultado(resultado);
FinAlgoritmo
