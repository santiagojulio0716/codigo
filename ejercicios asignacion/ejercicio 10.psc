Algoritmo Area_Rectangulo
    Definir base Como Real
	Definir altura Como Real
	Definir area Como Real
	
    Escribir "Ingrese la base"
    Leer base
    Escribir "Ingrese la altura"
    Leer altura
	
    area <- base * altura
	
    Escribir "El area del rectangulo es: " + ConvertirATexto(area);
FinAlgoritmo
