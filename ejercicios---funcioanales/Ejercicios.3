Funcion leerDatos(precio Por Referencia, cantidad Por Referencia)
    Escribir "Ingrese el precio unitario: "
    Leer precio
    Escribir "Ingrese la cantidad: "
    Leer cantidad
FinFuncion

Funcion total <- calcularTotal(precio, cantidad)
    Definir total Como Real
    total <- precio * cantidad
FinFuncion

Funcion mostrarResultado(total, iva)
    Escribir "El total de la compra es: $", total
    Escribir "El IVA es: $", iva
    Escribir "Total con IVA: $", total + iva
FinFuncion

Algoritmo Principal
    Definir precio, cantidad, total, iva Como Real;
	
    leerDatos(precio, cantidad);
	
    total <- calcularTotal(precio, cantidad);
    iva <- total * 0.19
	
    mostrarResultado(total, iva;)
FinAlgoritmo