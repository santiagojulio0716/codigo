Funcion leerNota(nota Por Referencia)
    Escribir "Ingrese la nota: "
    Leer nota
FinFuncion

Funcion promedio <- calcularPromedio(nota1, nota2, nota3)
    Definir promedio Como Real;
    promedio <- (nota1 + nota2 + nota3) / 3
FinFuncion

Funcion mostrarResultado(promedio)
    Escribir "El promedio de las tres materias es: ", + promedio
FinFuncion

Algoritmo Principal
    Definir nota1, nota2, nota3, resultado Como Real;
	
    leerNota(nota1);
    leerNota(nota2);
    leerNota(nota3);
	
    resultado <- calcularPromedio(nota1, nota2, nota3);
    mostrarResultado(resultado);
FinAlgoritmo