Funcion leerVentas(ventas Por Referencia)
    Definir i Como Entero
    Para i <- 1 Hasta 7 Con Paso 1 Hacer
        Escribir "Ingrese las ventas del dia ", i, ": "
        Leer ventas[i]
    FinPara
FinFuncion

Funcion total <- sumarVentas(ventas)
    Definir total Como Real
    Definir i Como Entero
    total <- 0
	
    Para i <- 1 Hasta 7 Con Paso 1 Hacer
        total <- total + ventas[i]
    FinPara
FinFuncion

Funcion mostrarResultado(total)
    Escribir "El total de ventas de la semana es: $", total
FinFuncion

Algoritmo Principal
    Definir ventas, resultado Como Real
    Dimension ventas[7]
	
    leerVentas(ventas)
	
    resultado <- sumarVentas(ventas)
	
    mostrarResultado(resultado)
FinAlgoritmo